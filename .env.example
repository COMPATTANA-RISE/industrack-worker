# MQTT (broker ภายนอก — ใน Docker ใช้ tcp://host.docker.internal:1883 ถ้า broker อยู่บน host)
MQTT_BROKER=tcp://localhost:1883
# client id ต้องคงที่ เพื่อให้ broker เก็บ session และคิวข้อความไว้ระหว่าง worker restart
MQTT_CLIENT_ID=idt-worker
MQTT_USER=
MQTT_PASS=
# QoS 1 + persistent session (clean session = false) = ไม่เสียข้อมูลตอน worker ล่ม/reconnect
MQTT_QOS=1
MQTT_CLEAN_SESSION=false
# true = ต่อท้าย client id แบบสุ่ม (ใช้เฉพาะตอนรันหลาย worker ชั่วคราว — resume session ไม่ได้)
MQTT_CLIENT_ID_RANDOM_SUFFIX=false

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=my-org
INFLUX_BUCKET=machine

# กฎตรวจข้อมูล (docs/DEVICE-PAYLOAD-CONTRACT.md §3)
# server = ไม่มี timestamp ให้ใช้เวลาที่ได้รับ (ติด flag ts_server) · reject = ทิ้งข้อความ
TIMESTAMP_POLICY=server
INGEST_FUTURE_SKEW_SECONDS=120
INGEST_LATE_SECONDS=60
# log สรุปจำนวนข้อความ (received/written/rejected/flagged) ทุกกี่วินาที
STATS_INTERVAL_SECONDS=60
